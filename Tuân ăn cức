-- 4. Logic giao tiếp toàn server cho người dùng script
local SCRIPT_CHAT_PREFIX = "[TAC_CHAT]:"
local ADMIN_ALERT_PREFIX = "[TAC_ADMIN]:"

local function appendScriptChat(senderName, text, isAdminAlert)
	local item = Instance.new("TextLabel")
	item.Size = UDim2.new(1, -8, 0, 22)
	item.BackgroundColor3 = isAdminAlert and Color3.fromRGB(70, 25, 45) or Color3.fromRGB(34, 30, 45)
	item.BorderSizePixel = 0
	item.Text = isAdminAlert and ("👑 [ADMIN] " .. senderName .. ": " .. text) or (senderName .. ": " .. text)
	item.TextColor3 = isAdminAlert and Color3.fromRGB(255, 215, 90) or Color3.fromRGB(235, 235, 245)
	item.Font = isAdminAlert and Enum.Font.GothamBold or Enum.Font.Gotham
	item.TextSize = 11
	item.TextWrapped = true
	item.AutomaticSize = Enum.AutomaticSize.Y
	item.TextXAlignment = Enum.TextXAlignment.Left
-- 6. Thanh kéo FOV & vòng lặp RenderStepped
local function setFovFromX(xPos)
	local rel = math.clamp((xPos - sliderTrack.AbsolutePosition.X) / math.max(1, sliderTrack.AbsoluteSize.X), 0, 1)
	fovRadius = math.floor(20 + rel * 480)
	fovCircle.Radius = fovRadius
	fovValueLabel.Text = "FOV Size: " .. tostring(fovRadius)
	sliderFill.Size = UDim2.new(rel, 0, 1, 0)
	sliderKnob.Position = UDim2.new(rel, -8, 0.5, -8)
end

sliderKnob.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		isDraggingFov = true
	end
end)

sliderTrack.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		isDraggingFov = true
		setFovFromX(input.Position.X)
	end
end)


